DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=meeting_app
DB_NAME=tuk_meeting_room
# Remote MySQL: enable TLS with hostname and certificate verification.
# DB_TLS=true
# DB_TLS_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Limit per app instance. Keep this low on a shared hosting plan.
# DB_CONNECTION_LIMIT=1
MYSQL_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password
STUDENT_PASSWORD=replace-with-local-student-password
ADMIN_PASSWORD=replace-with-local-admin-password
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SCHOOL_SESSION_KEY=replace-with-32-byte-base64-key
